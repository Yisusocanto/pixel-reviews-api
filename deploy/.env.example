# Copiar a deploy/.env EN LA VM (nunca commitear el real) y rellenar. chmod 600 .env
# Generar secretos con: openssl rand -hex 32

ENVIRONMENT=production
API_DOMAIN=api.pixelreviews.app

# Neon: usar la URL DIRECTA (host sin "-pooler") en formato asyncpg
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-xxxx.us-west-2.aws.neon.tech/DBNAME?ssl=require

BACKEND_URL=https://api.pixelreviews.app
FRONTEND_URL=https://pixelreviews.app

# REDIS_URL y RABBITMQ_URL los define docker-compose.prod.yml
RABBITMQ_USER=pixel
RABBITMQ_PASSWORD=change_me

JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
MODERATION_SERVICE_KEY=change_me

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
RESEND_API_KEY=
RESEND_DOMAIN=
CF_ACCOUNT_ID=
CF_BUCKET=
CF_PUBLIC_URL=
CF_ACCESS_KEY_ID=
CF_SECRET_ACCESS_KEY=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-decision-1
